# Local profile:
FILE_WORKER_IMAGE=vhb-file-worker:dev

# Staging/production must replace the line above with an approved immutable
# release digest emitted by CI, for example:
# FILE_WORKER_IMAGE=ghcr.io/vihaba/vhb-file-worker@sha256:<approved-digest>

FILE_WORKER_INPUT_DIR=/absolute/path/to/one-job/input
FILE_WORKER_OUTPUT_DIR=/absolute/path/to/one-job/output
VCS_REF=local
